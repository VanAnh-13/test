# ── Secrets — TUYỆT ĐỐI không vào image (repo public, image có thể bị push) ──
.env
.env.*
*.pem
*.key

# ── Git & IDE ──
.git
.gitignore
.vscode/
.idea/

# ── Python cache & virtualenv (nặng nhất context) ──
__pycache__/
*.pyc
*.pyo
*.pyd
.venv/
venv/
env/
.pytest_cache/
.ruff_cache/
htmlcov/
.coverage

# ── Docker (không cần trong context; compose truyền dockerfile riêng) ──
Dockerfile
*.dockerfile
docker-compose*.yaml
docker-compose*.yml
.dockerignore

# ── Không phải runtime: test, bài báo, tài liệu, kết quả thí nghiệm ──
tests/
paper/
README.md
LICENSE
*.sh
benchmarks/*.jsonl
benchmarks/*.json

# ── Data lớn không thuộc image (checkpoint world_model NHỎ thì GIỮ) ──
assets/end_users
assets/online_shoppers
assets/desc.md
assets/*.csv
data/world_model/warmup_trajectories.jsonl
