# ══════════════════════════════════════════════════════════
# HAgent deploy — biến môi trường LLM (copy sang .env rồi điền)
#
# QUAN TRỌNG: resolve model giờ STRICT — LLM_DEFAULT_MODEL sai tên sẽ làm
# service NỔ NGAY khi gọi LLM đầu tiên (kèm danh sách tên hợp lệ) thay vì
# âm thầm rơi về openai-gpt4o-mini tính phí như trước.
# ══════════════════════════════════════════════════════════

# ── Chọn model mặc định (tên PHẢI có trong hagent.yaml llm.models) ──
# Hợp lệ hiện tại: openai-gpt4o-mini | openai-gpt4o | anthropic-sonnet |
#                  local-compatible | ci-mock | ollama-ci
# Per-request override: client gửi {"model": "<tên>"} — tên sai trả HTTP 400.
LLM_DEFAULT_MODEL=ollama-ci

# ── Ollama (LLM local, chạy trên HOST — compose trỏ host.docker.internal) ──
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:14b
# Giữ model trong RAM giữa các request (tránh phí nạp lại ~30-60s):
# đặt trên host trước khi `ollama serve`:  OLLAMA_KEEP_ALIVE=-1

# ── API thương mại (chỉ cần khi dùng model tương ứng) ──
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# OpenAI-compatible tự host (vLLM/LM Studio/llama.cpp) — model local-compatible:
CUSTOM_API_KEY=
# LOCAL_BASE_URL=http://host.docker.internal:8000/v1
# LOCAL_MODEL_NAME=qwen2.5-14b-instruct

# ── Theo dõi chi phí ──
# Bảng giá per-1M-token nằm ở hagent.yaml llm.usage_tracking.pricing;
# tokens + USD trả về trong cost_metrics của mọi response. Model không có
# trong bảng giá (Ollama/local) → cost 0 theo thiết kế.

# ── Tắt telemetry bên thứ ba ──
LANGCHAIN_TRACING_V2=false
DO_NOT_TRACK=1

# ── Bảo mật chung (bắt buộc cho compose) ──
SECRET_KEY=
HAGENT_HOOKS_TOKEN=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
