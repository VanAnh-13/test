# ──────────────────────────────────────────────────────────────────────────
# File này là template công khai (push lên GitHub được).
# Copy thành `.env` rồi thay thế CÁC GIÁ TRỊ CÓ DẤU <...> bằng giá trị
# thật cho môi trường của bạn. File `.env` đã được ignore bởi git.
#
# Sinh secret key an toàn:
#   python -c "from config.settings import generate_secret_key; print(generate_secret_key())"
# ──────────────────────────────────────────────────────────────────────────

# ── Chế độ triển khai ─────────────────────────────────────────────────────
# Các giá trị hợp lệ: development | test | private | public
# Ở chế độ 'private' và 'public', các SECRET bắt buộc phải khác placeholder.
DEPLOY_MODE=development

# ── Auth / Security (BẮT BUỘC đổi trước khi deploy production) ───────────
# SECRET_KEY dùng để ký JWT access/refresh token và session cookie.
# Phải là chuỗi ngẫu nhiên, dài ≥ 32 ký tự, duy nhất cho mỗi môi trường.
SECRET_KEY=<sinh-bang-generate_secret_key-thay-the-dong-nay>
ALGORITHM=HS256
ACCESS_EXPIRE=60
REFRESH_EXPIRE=7
SKIP_EMAIL_VERIFICATION=true

# Session (Starlette SessionMiddleware)
SESSION_SECRET=<giong-SECRET_KEY-hoac-de-trong-neu-dung-chung-SECRET_KEY>
SESSION_HTTPS_ONLY=false

# ── Toolkit (FastAPI backend) ──────────────────────────────────────────────
TOOLKIT_IMAGE=hautoml-toolkit
TOOLKIT_CONTAINER_NAME=toolkit-testing
TOOLKIT_HOST_PORT=5370
TOOLKIT_PORT=8585

# ── Worker (AutoML worker, profile=worker) ────────────────────────────────
WORKER_IMAGE=workers:latest
WORKER_CONTAINER_NAME=hautoml-woker-1-testing
WORKER_PORT=5101
WORKER_INDEX=1

# CLUSTER_SHARED_SECRET: dùng chung giữa Master (automl/v2/master.py) và mọi
# Worker (cluster/worker.py) để xác thực các endpoint nội bộ /task/get,
# /task/submit, /check-for-work, /cancel-task. BẮT BUỘC đổi khỏi giá trị mặc
# định trước khi deploy production (DEPLOY_MODE=private|public sẽ fail-fast
# nếu vẫn giữ giá trị mặc định).
CLUSTER_SHARED_SECRET=<sinh-bang-generate_secret_key-thay-the-dong-nay>
WORKER_LIST=http://worker-1:5101

# ── Nano (Gradio demo, profile=nano) ──────────────────────────────────────
NANO_IMAGE=hautoml-nano
NANO_CONTAINER_NAME=hautoml_nano_v1_testing
NANO_PORT=5106

# ── MongoDB ────────────────────────────────────────────────────────────────
MONGO_IMAGE=mongo:latest
MONGO_CONTAINER_NAME=mongodb_hautoml_testing
MONGO_HOST_PORT=5380
MONGO_DATA_DIR=/data/mongodb/mongo-automl
# URI kết nối đầy đủ (dùng trong AppSettings)
MONGODB_CONNECT=mongodb://localhost:27017
MONGODB_DB_NAME=hautoml
MONGODB_TIMEOUT_MS=2000
# MONGO_ROOT_USERNAME=root
# MONGO_ROOT_PASSWORD=<doi-truoc-khi-deploy>

# ── Kafka ──────────────────────────────────────────────────────────────────
KAFKA_IMAGE=apache/kafka:latest
KAFKA_CONTAINER_NAME=kafka-testing
KAFKA_HOST_PORT=5383
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=example-topic

# ── MinIO (BẮT BUỘC đổi trước khi deploy production) ─────────────────────
MINIO_IMAGE=minio/minio:latest
MINIO_CONTAINER_NAME=minio_hautoml_testing
MINIO_HOST_PORT=5381
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
# MINIO_SECRET_KEY ở development có thể giữ 'minioadmin'.
# Ở production (DEPLOY_MODE=private|public) BẮT BUỘC đổi thành giá trị bí mật.
MINIO_SECRET_KEY=<doi-truoc-khi-deploy-len-server>
MINIO_SECURE=false

# ── HAgent Bridge ──────────────────────────────────────────────────────────
HAGENT_BRIDGE_IMAGE=hagent-bridge:latest
HAGENT_BRIDGE_CONTAINER_NAME=hagent_bridge_testing
HAGENT_BRIDGE_HOST_PORT=5360
HAGENT_BRIDGE_PORT=9900

# ── CORS & Host ────────────────────────────────────────────────────────────
# Danh sách origin được phép, phân cách bằng dấu phẩy.
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
HOST=0.0.0.0
PORT=8080
RELOAD=false

# ── Email / SMTP (dùng cho OTP và reset mật khẩu) ─────────────────────────
# CONTACT_SMTP_HOST=smtp.gmail.com
# CONTACT_SMTP_PORT=587
# CONTACT_SMTP_USERNAME=<email-gui-di>
# CONTACT_SMTP_PASSWORD=<mat-khau-app-smtp>
# CONTACT_RECEIVER_EMAIL=<email-nhan-lien-he>
# PASSWORD_RESET_EXPIRE_MINUTES=5
