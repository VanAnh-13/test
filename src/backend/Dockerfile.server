FROM python:3.12-slim@sha256:57cd7c3a7a273101a6485ba99423ee568157882804b1124b4dd04266317710de

LABEL org.opencontainers.image.title="HAgent Backend"
LABEL org.opencontainers.image.description="HAutoML toolkit, worker và LangGraph HAgent"

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app \
    PIP_NO_CACHE_DIR=1 \
    HOME=/home/hagent \
    HAGENT_CONFIG=/app/hagent/config/hagent.yaml

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        libgl1 \
        libglib2.0-0 \
        libgomp1 \
    && groupadd --gid 10001 hagent \
    && useradd --uid 10001 --gid 10001 --create-home --home-dir /home/hagent hagent \
    && install -d -o 10001 -g 10001 /var/lib/hagent \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements.txt /tmp/requirements.txt
RUN python -m pip install --no-cache-dir --requirement /tmp/requirements.txt \
    && rm -f /tmp/requirements.txt

# Source chỉ đọc; dữ liệu runtime phải ghi vào volume /var/lib/hagent.
COPY --chown=root:root . /app
RUN chmod -R a-w /app

USER 10001:10001

EXPOSE 8585 5101
STOPSIGNAL SIGTERM

CMD ["uvicorn", "server.application:app", "--host", "0.0.0.0", "--port", "8585"]
